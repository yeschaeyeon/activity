/* ==========================================================
   활동 달력 — "종이에 잉크로 그은 선처럼"
   색과 글꼴은 :root 변수만 바꾸면 전체 분위기가 바뀐다.
   형광펜(--h0~--h5)은 강조 클래스 c0~c5에만 쓴다.
   ========================================================== */
:root {
  --bg: #ffffff;
  --ink: #111111;
  --sub: #7d828b;
  --line: #d9dbe0;
  --soft: #f3f4f6;
  --err: #c0392b;
  --h0: #7fe98d;
  --h1: #fbe24d;
  --h2: #f4a6ef;
  --h3: #5fb6f2;
  --h4: #6ee7c8;
  --h5: #ff7b7b;
  --font: 'Pretendard', 'Pretendard Variable', -apple-system, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;
  --bar-h: 52px;
  --nav-h: 54px;
  --veil: rgba(255, 255, 255, 0.92);
}

/* 모든 요소: 각진 모서리, 그림자 없음, 즉시 전환 */
* {
  box-sizing: border-box;
  border-radius: 0 !important;
  box-shadow: none !important;
  animation: none !important;
  transition: none !important;
}

html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font);
  font-size: 15px;
  line-height: 1.5;
}
h1, h2, h3, p, ul, ol, dl, dd { margin: 0; padding: 0; }
h2 { font-size: 20px; font-weight: 700; line-height: 1.35; }
h3 { font-size: 16px; font-weight: 700; line-height: 1.4; }
ul, ol { list-style: none; }
button, input { font-family: inherit; color: inherit; }
a { color: inherit; }
:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
[hidden] { display: none !important; }

.sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
.sub { font-size: 13px; color: var(--sub); }
.num { font-size: 20px; font-weight: 800; font-variant-numeric: tabular-nums; }

/* ---------- 아이콘 ---------- */
.icon {
  width: 22px; height: 22px; flex: none;
  fill: none; stroke: currentColor; stroke-width: 1.5;
  stroke-linecap: square; stroke-linejoin: miter;
}

/* ---------- 상단 바 ---------- */
.topbar {
  position: sticky; top: 0; z-index: 10;
  background: var(--bg);
  border-bottom: 1.5px solid var(--ink);
  padding: env(safe-area-inset-top) calc(8px + env(safe-area-inset-right)) 0 calc(16px + env(safe-area-inset-left));
}
.topbar-in {
  height: var(--bar-h);
  max-width: 1180px; margin: 0 auto;
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
}
.topbar h1 { font-size: 17px; font-weight: 700; }
.topbar-right { display: flex; align-items: center; gap: 4px; }
.icon-btn {
  width: 44px; height: 44px; padding: 0;
  display: inline-grid; place-items: center;
  background: transparent; border: 0; cursor: pointer; color: var(--ink);
}
.icon-btn:active { background: var(--ink); color: var(--bg); }

/* ---------- 본문 ---------- */
.page {
  max-width: 1180px; margin: 0 auto;
  padding: 16px calc(16px + env(safe-area-inset-right))
           calc(var(--nav-h) + 40px + env(safe-area-inset-bottom))
           calc(16px + env(safe-area-inset-left));
}
.stack { display: grid; gap: 12px; }
.row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.row.between { justify-content: space-between; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }

/* ---------- 하단 메뉴 ---------- */
.nav {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
  background: var(--bg);
  border-top: 1.5px solid var(--ink);
  height: calc(var(--nav-h) + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
}
.nav a {
  flex: 1 1 0; min-width: 44px; height: var(--nav-h);
  display: grid; place-items: center;
  color: var(--ink); text-decoration: none;
}
.nav a .icon { width: 26px; height: 26px; }
.nav a[aria-current="page"], .nav a:active { background: var(--ink); color: var(--bg); }

/* ---------- 버튼 ---------- */
.btn {
  position: relative;
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  min-height: 44px; padding: 9px 14px;
  background: var(--bg); color: var(--ink);
  border: 1.5px solid var(--ink);
  font-size: 15px; font-weight: 600; line-height: 1.3;
  text-decoration: none; cursor: pointer;
}
.btn .icon { width: 16px; height: 16px; }
.btn:active, .btn.solid { background: var(--ink); color: var(--bg); }
.btn.solid:active { background: var(--bg); color: var(--ink); }
.btn.sm { min-height: 32px; padding: 4px 10px; font-size: 13px; font-weight: 500; }
.btn.sm::after { content: ""; position: absolute; left: 0; right: 0; top: -6px; bottom: -6px; }
.btn.block { display: flex; width: 100%; }
.btn.danger { color: var(--err); border-color: var(--err); }
.btn.danger.confirm { background: var(--err); color: var(--bg); }
.btn:disabled, .btn.disabled { opacity: 0.35; pointer-events: none; }

/* ---------- 입력칸 ---------- */
.field { display: block; }
.field > span { display: block; font-size: 13px; color: var(--sub); margin-bottom: 4px; }
.input {
  display: block; width: 100%; min-height: 44px; padding: 10px 12px;
  background: var(--bg); color: var(--ink);
  border: 1.5px solid var(--ink);
  font-size: 15px; line-height: 1.5;
}
.input:focus { background: var(--soft); outline: none; }

/* ---------- 칩 · 세그먼트 · 태그 · 점 ---------- */
.chip {
  position: relative;
  display: inline-flex; align-items: center; gap: 6px;
  padding: 5px 10px; min-height: 32px;
  background: var(--bg); color: var(--ink);
  border: 1.5px solid var(--ink);
  font-size: 13px; font-weight: 600; line-height: 1.3;
  text-decoration: none; cursor: pointer;
}
.chip::after { content: ""; position: absolute; left: 0; right: 0; top: -6px; bottom: -6px; }
.chip.on, .chip:active { background: var(--ink); color: var(--bg); }
.chip .cnt { font-weight: 500; font-variant-numeric: tabular-nums; }

.seg { display: flex; border: 1.5px solid var(--ink); }
.seg button {
  flex: 1 1 0; min-height: 44px; padding: 8px 6px;
  background: var(--bg); color: var(--ink);
  border: 0; border-left: 1px solid var(--line);
  font-size: 13px; font-weight: 600; cursor: pointer;
}
.seg button:first-child { border-left: 0; }
.seg button.on, .seg button:active { background: var(--ink); color: var(--bg); }

.tag {
  display: inline-block; padding: 0 6px;
  border: 1px solid var(--ink); background: var(--bg); color: var(--ink);
  font-size: 12px; font-weight: 600; line-height: 1.6;
}
.dot {
  display: inline-block; flex: none; width: 12px; height: 12px;
  border: 1px solid var(--ink);
}

/* ---------- 형광펜 (강조 전용) ---------- */
.c0 { background: var(--h0); color: var(--ink); }
.c1 { background: var(--h1); color: var(--ink); }
.c2 { background: var(--h2); color: var(--ink); }
.c3 { background: var(--h3); color: var(--ink); }
.c4 { background: var(--h4); color: var(--ink); }
.c5 { background: var(--h5); color: var(--ink); }
mark {
  background: transparent; color: inherit;
  padding: 0 6px; margin: 0 -6px;
  -webkit-box-decoration-break: clone; box-decoration-break: clone;
}
mark.c0 { background: var(--h0); }
mark.c1 { background: var(--h1); }
mark.c2 { background: var(--h2); }
mark.c3 { background: var(--h3); }
mark.c4 { background: var(--h4); }
mark.c5 { background: var(--h5); }

/* ---------- 카드 · 안내 · 빈 상태 · details ---------- */
.card {
  display: block; width: 100%; padding: 14px;
  background: var(--bg); color: var(--ink);
  border: 1.5px solid var(--ink);
  text-align: left; font-size: 15px; line-height: 1.5;
}
button.card { cursor: pointer; }
button.card:active { background: var(--ink); color: var(--bg); }
button.card:active .tag { background: var(--bg); color: var(--ink); }
.card .top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
.card .name { display: block; font-size: 16px; font-weight: 700; line-height: 1.45; margin-bottom: 6px; padding: 0 6px; }
.card .meta { display: block; font-size: 13px; color: var(--sub); }
.card .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.card.done { border-color: var(--sub); }
.card.done .name { color: var(--sub); }
.card .d { font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums; }

.list { display: grid; gap: 12px; }

.note { background: var(--soft); border: 1.5px solid var(--ink); padding: 12px 14px; }
.note b { display: block; margin-bottom: 4px; }
.note p { font-size: 13px; }

.empty { border: 1px dashed var(--sub); color: var(--sub); padding: 24px 14px; text-align: center; }

details { border: 1.5px solid var(--ink); background: var(--bg); }
summary {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  min-height: 44px; padding: 10px 14px;
  font-weight: 700; cursor: pointer; list-style: none;
}
summary::-webkit-details-marker { display: none; }
summary::after { content: "+"; font-size: 18px; font-weight: 700; }
details[open] > summary::after { content: "\2013"; }
details[open] > summary { border-bottom: 1px solid var(--line); }
.det-body { padding: 14px; display: grid; gap: 12px; }

/* ---------- 달력 ---------- */
.home { display: grid; gap: 16px; }
.cal-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.cal-head h2 { font-variant-numeric: tabular-nums; }
.cal-head .row { gap: 0; }
.cal {
  display: grid; grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 1px; background: var(--line);
  border: 1.5px solid var(--ink);
}
.cal-dow {
  background: var(--bg); padding: 6px 0; text-align: center;
  font-size: 12px; font-weight: 600;
}
.cal-blank { background: var(--soft); min-height: 92px; }
.cal-cell {
  display: block; min-width: 0; min-height: 92px; padding: 4px 2px 4px;
  background: var(--bg); color: var(--ink);
  border: 0; text-align: left; font-size: 12px; cursor: pointer;
}
.cal-d {
  display: inline-block; min-width: 22px; padding: 0 3px; margin-bottom: 2px;
  font-size: 12px; font-weight: 700; text-align: center;
  font-variant-numeric: tabular-nums; border: 1.5px solid transparent;
}
.cal-cell.today .cal-d { border-color: var(--ink); }
.cal-cell.sel { background: var(--ink); color: var(--bg); }
.cal-cell.sel.today .cal-d { border-color: var(--bg); }
.cal-item {
  display: block; margin-top: 2px; padding: 1px 3px;
  font-size: 10px; font-weight: 600; line-height: 1.35;
  overflow: hidden; word-break: break-all;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2;
}
.cal-more { display: block; margin-top: 2px; padding: 0 3px; font-size: 10px; font-weight: 600; color: var(--sub); }
.cal-cell.sel .cal-more { color: var(--bg); }

.legend { display: flex; flex-wrap: wrap; gap: 6px; }

.day-panel { display: grid; gap: 12px; align-content: start; }
.day-panel > header { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }

/* ---------- 상세 모달 ---------- */
.modal-back {
  position: fixed; inset: 0; z-index: 50;
  background: var(--veil);
  display: flex; align-items: flex-start; justify-content: center;
  padding: calc(env(safe-area-inset-top) + 24px) 16px 24px;
  overflow: auto;
}
.modal { width: 100%; max-width: 480px; background: var(--bg); border: 1.5px solid var(--ink); }
.modal.wide { max-width: 860px; }
.modal-head {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  padding: 0 0 0 14px; border-bottom: 1.5px solid var(--ink);
}
.modal-head h2 { padding: 10px 0; font-size: 18px; word-break: keep-all; }
.modal-body { padding: 14px; display: grid; gap: 12px; }
.kv { display: grid; }
.kv > div { padding: 10px 0; border-bottom: 1px solid var(--line); }
.kv > div:first-child { padding-top: 0; }
.kv dt { font-size: 13px; color: var(--sub); }
.kv dd { margin-top: 2px; word-break: keep-all; overflow-wrap: anywhere; }
.kv .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }

/* ---------- 토스트 ---------- */
.toast {
  position: fixed; left: 50%; z-index: 60;
  bottom: calc(var(--nav-h) + env(safe-area-inset-bottom) + 16px);
  transform: translateX(-50%);
  width: calc(100% - 32px); max-width: 460px;
  padding: 10px 14px; background: var(--ink); color: var(--bg);
  font-size: 14px; text-align: center;
}

/* ---------- 반응형 ---------- */
@media (min-width: 700px) {
  .list { grid-template-columns: 1fr 1fr; }
  .cal-cell, .cal-blank { min-height: 116px; padding: 6px 4px; }
  .cal-item { font-size: 12px; padding: 1px 4px; -webkit-line-clamp: 1; line-clamp: 1; word-break: normal; }
  .cal-more { font-size: 12px; }
  .cal-d { font-size: 13px; }
  .cal-dow { font-size: 13px; }
}
@media (min-width: 880px) {
  .home { grid-template-columns: minmax(0, 1fr) 360px; align-items: start; }
  .cal-cell, .cal-blank { min-height: 100px; }
  .day-panel {
    position: sticky; top: calc(var(--bar-h) + env(safe-area-inset-top) + 16px);
    max-height: calc(100vh - var(--bar-h) - var(--nav-h) - 72px);
    overflow-y: auto; padding-right: 2px;
  }
  .day-panel .list { grid-template-columns: 1fr; }
}

/* ---------- 인쇄 ---------- */
@media print {
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  @page { size: A4; margin: 12mm; }
  .topbar, .nav, .toast, .modal-back { display: none !important; }
  body { background: #fff; color: #000; }
  .page { max-width: none; padding: 0; }
  .home { display: block; }
  .home > * + * { margin-top: 12px; }
  .day-panel { position: static; max-height: none; overflow: visible; }
  .cal-cell, .cal-blank { min-height: 80px; }
  .cal, .card { break-inside: avoid; }
  .cal-item { font-size: 9px; }
  .icon-btn, .btn, .chip, .seg { display: none; }
  .cal-head .row { display: none; }
}
